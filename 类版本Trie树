class Trie {
    class Node{
        Map<Character,Node> node;
        boolean end;
        public Node(){
            node = new HashMap<>();
            end = false;
        }
    }
    Node root;
    public Trie() {
        root = new Node();
    }
    public void insert(String word) {
        Node node = root;
        for(char c : word.toCharArray()){
            if(node.node.get(c)==null){node.node.put(c,new Node());}
            node=node.node.get(c);
        }
        node.end=true;
    }
    
    public boolean search(String word) {
        Node node = root;
        for(char c : word.toCharArray()){
            if(node.node.get(c)==null){return false;}
            node = node.node.get(c);
        }
        return node.end;
    }
    
    public boolean startsWith(String prefix) {
        Node node = root;
        for(char c : prefix.toCharArray()){
            if(node.node.get(c)==null){return false;}
            node=node.node.get(c);
        } 
        return true;
    }
}
